<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>UpComing Service Projects</h2>
    <ul>
        <% projects.forEach(project => { %>
        <li>
            <strong>
                <%= new Date(project.date).toLocaleDateString('en-US', {
                    month: 'long',
                    day: 'numeric',
                    year: 'numeric'
                }) %>:
                <%= project.title %> 
                (<%= project.organization %>)
            </strong>
        </li>
        <% }) %>
    </ul>
    
</main>
<%- include('partials/footer') %>