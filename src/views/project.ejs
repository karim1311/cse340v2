<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= projectDetails.title %></h2>

    <p><%= projectDetails.description %></p>
    <p>
        <%= new Date(projectDetails.date).toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric'
        }) %>
    </p>
    <p><%= projectDetails.location %></p>
    <p><a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></p>

    <ul>
        <% categories.forEach(category => { %>
        <li><a href="/category/<%= category.category_id %>"><%= category.category_name %></a></li>
        <% }) %>
    </ul>

    
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a></p>
    <% } %>
        
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/assign-categories/<%= projectDetails.project_id  %>">Edit Categories</a></p>
    <% } %>
    
</main>
<%- include('partials/footer') %>